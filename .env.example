# Database
DATABASE_URL="postgresql://tracker:tracker@localhost:5432/tracker"

# Auth
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Google OAuth (sign-in + Calendar)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URL="http://localhost:3000/api/auth/google/callback"
GOOGLE_CALENDAR_WEBHOOK_URL="https://<your-domain>/api/calendar/webhook"
CALENDAR_TOKEN_ENCRYPTION_KEY="" # base64-encoded 32 random bytes — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Redis (BullMQ queues: notifications, calendar sync, watch-channel renewal)
REDIS_URL="redis://localhost:6379"

# Email provider (Resend/SendGrid/SES - pick one)
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="notifications@tracker.example"

# Push (Firebase Cloud Messaging - mobile + web push)
FCM_SERVICE_ACCOUNT_JSON=""

# Seed
SEED_OWNER_EMAIL="gervaseanselm@gmail.com"
